# Modèle de configuration. Copier en .env puis renseigner les valeurs.
# Ne jamais versionner .env. Détail de chaque variable : CONFIGURATION.md

# --- API ---
API_ENV=development
# Origines autorisées à appeler l'API (l'interface web), séparées par des virgules.
API_CORS_ORIGINS=http://localhost:5173

# --- Authentification (JWT) ---
# OBLIGATOIRE. L'API refuse de démarrer avec une valeur vide ou « changeme ».
# Générer : openssl rand -hex 32
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Une session expire après N minutes sans requête, et au plus tard N heures
# après la connexion.
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_MAX_HOURS=12

# --- Hachage des mots de passe trouvés dans les documents collectés ---
# OBLIGATOIRE. Poivre du HMAC-SHA256, conservé hors de la base.
# Générer : openssl rand -hex 32
# Ne plus le changer une fois des données collectées : les empreintes
# existantes deviendraient incomparables avec les nouvelles.
PASSWORD_HASH_PEPPER=

# --- Postgres ---
POSTGRES_USER=tip_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=threat_intel
DATABASE_URL=postgresql+psycopg://tip_user:changeme@db:5432/threat_intel

# --- Redis et Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Tor (collecte) ---
TOR_SOCKS_HOST=tor
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=tor
TOR_CONTROL_PORT=9051
# Mot de passe du port de contrôle (rotation de circuit). Il est haché à la
# construction de l'image tor : le changer impose de reconstruire `tor`.
TOR_CONTROL_PASSWORD=changeme

# --- Modèle de langue ---
# Ollama tourne sur la machine hôte, hors des conteneurs.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modèle des résumés et de l'analyse. Exige `ollama pull qwen3:8b`.
LLM_MODEL=ollama:qwen3:8b
# Fournisseurs en ligne, facultatifs (laisser vide si non utilisés).
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Enrichissement (facultatif) ---
# IntelX, compte gratuit : https://intelx.io/account?tab=developer
INTELX_API_KEY=

# --- Telegram, Client API (facultatif) ---
# Vides : les canaux publics sont lus par l'aperçu web t.me/s/, sans compte.
# Valeurs sur https://my.telegram.org > API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Alertes régionales ---
# Continents surveillés pour signaler les victimes non déclarées.
# Vide : seules les organisations déclarées produisent des alertes.
ALERT_WATCHED_CONTINENTS=Afrique

# --- Planification initiale (heures UTC, format crontab) ---
# Ces valeurs ne servent qu'à remplir la table des tâches au premier
# démarrage. Ensuite, la planification se modifie depuis l'interface.
COLLECT_SCHEDULE_HOURS=6,18
COLLECT_SCHEDULE_MINUTE=17
ALERT_SCHEDULE_MINUTE=7
LINK_CHECK_SCHEDULE_HOUR=9
LINK_CHECK_SCHEDULE_MINUTE=37
DREAD_COLLECT_SCHEDULE_HOUR=13
DREAD_COLLECT_SCHEDULE_MINUTE=23
